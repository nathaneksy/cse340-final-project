<h1>Add Category</h1>
<% if (errors && errors.length > 0) { %>

<div class="errors">

<ul>

<% errors.forEach(error => { %>

<li><%= error.msg %></li>

<% }) %>

</ul>

</div>

<% } %>
<form
  action="/admin/categories/new"
  method="POST"
>

  <label for="category_name">
    Category Name
  </label>

  <br>

  <input
    type="text"
    id="category_name"
    name="category_name"
    value="<%= formData?.category_name || '' %>"
    required
  >

  <br><br>

  <button type="submit">
    Add Category
  </button>

</form>

<br>

<p>
  <a href="/admin/categories">
    Back to Categories
  </a>
</p>