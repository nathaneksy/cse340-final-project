<h1>Add Category</h1>

<form
  action="/admin/categories/new"
  method="POST"
>

  <label for="category_name">
    Category Name
  </label>

  <br>

  <input
    type="text"
    id="category_name"
    name="category_name"
    required
  >

  <br><br>

  <button type="submit">
    Add Category
  </button>

</form>

<br>

<p>
  <a href="/admin/categories">
    Back to Categories
  </a>
</p>