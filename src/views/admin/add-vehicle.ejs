<%- include("../partials/head") %>

<%- include("../partials/header") %>

<h1>Add Vehicle</h1>

<% if (errors && errors.length > 0) { %>

<div class="errors">
  <ul>

    <% errors.forEach(error => { %>

      <li><%= error.msg %></li>

    <% }) %>

  </ul>
</div>

<% } %>

<form
  action="/admin/vehicles/new"
  method="POST"
>

<label>Category</label>

<select
  name="category_id"
  required
>

<% categories.forEach(category => { %>

    <option
      value="<%= category.category_id %>"
      <%= Number(formData?.category_id) === category.category_id ? "selected" : "" %>
    >
    <%= category.category_name %>
  </option>

<% }) %>

</select>

<br><br>

<label>Year</label> 
<input
  type="number"
  name="year"
  required
>

<br><br>

<label>Make</label>
<input
  type="text"
  name="make"
  value="<%= formData?.make || '' %>"
  required
>

<br><br>

<label>Model</label>
<input
  type="text"
  name="model"
  value="<%= formData?.model || '' %>"
  required
>

<br><br>

<label>Mileage</label>
<input
  type="number"
  name="mileage"
  value="<%= formData?.mileage || '' %>"
  required
>

<br><br>

<label>Price</label>
<input
  type="number"
  step="0.01"
  name="price"
  value="<%= formData?.price || '' %>"
  required
>

<br><br>

<label>Description</label>

<textarea
  name="description"
  required
><%= formData?.description || "" %>
</textarea>

<br><br>

<button>
  Add Vehicle
</button>

</form>

<%- include("../partials/footer") %>