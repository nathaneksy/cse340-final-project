<h1>Add Vehicle</h1>

<form
  action="/admin/vehicles/new"
  method="POST"
>

<label>Category</label>

<select
  name="category_id"
  required
>

<% categories.forEach(category => { %>

  <option
    value="<%= category.category_id %>"
  >
    <%= category.category_name %>
  </option>

<% }) %>

</select>

<br><br>

<label>Year</label>
<input
  type="number"
  name="year"
  required
>

<br><br>

<label>Make</label>
<input
  type="text"
  name="make"
  required
>

<br><br>

<label>Model</label>
<input
  type="text"
  name="model"
  required
>

<br><br>

<label>Mileage</label>
<input
  type="number"
  name="mileage"
  required
>

<br><br>

<label>Price</label>
<input
  type="number"
  step="0.01"
  name="price"
  required
>

<br><br>

<label>Description</label>

<textarea
  name="description"
  required
></textarea>

<br><br>

<button>
  Add Vehicle
</button>

</form>