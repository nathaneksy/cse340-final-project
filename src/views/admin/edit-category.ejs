<h1>Edit Category</h1>

<form
  action="/admin/categories/edit/<%= category.category_id %>"
  method="POST"
>

  <label for="category_name">
    Category Name
  </label>

  <br>

  <input
    type="text"
    id="category_name"
    name="category_name"
    value="<%= category.category_name %>"
    required
  >

  <br><br>

  <button type="submit">
    Save Changes
  </button>

</form>

<br>

<p>
  <a href="/admin/categories">
    Back to Categories
  </a>
</p>