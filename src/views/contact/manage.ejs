<%- include("../partials/head") %>

<%- include("../partials/header") %>

<main>
  <h1>Contact Messages</h1>

  <% if (messages.length === 0) { %>

    <p>No messages found.</p>

  <% } else { %>

    <table border="1">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Subject</th>
          <th>Date</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>
        <% messages.forEach(message => { %>

          <tr>
            <td><%= message.name %></td>

            <td>
              <a href="mailto:<%= message.email %>">
                <%= message.email %>
              </a>
            </td>

            <td><%= message.subject %></td>

            <td>
              <%= new Date(message.created_at).toLocaleString() %>
            </td>

            <td>
              <form
                action="/contact/manage/<%= message.message_id %>/status"
                method="POST"
              >
                <select name="status">
                  <option
                    value="Received"
                    <%= message.status === "Received" ? "selected" : "" %>
                  >
                    Received
                  </option>

                  <option
                    value="Replied"
                    <%= message.status === "Replied" ? "selected" : "" %>
                  >
                    Replied
                  </option>

                  <option
                    value="Closed"
                    <%= message.status === "Closed" ? "selected" : "" %>
                  >
                    Closed
                  </option>
                </select>

                <button type="submit">
                  Update
                </button>
              </form>
            </td>
          </tr>

          <tr>
            <td colspan="5">
              <strong>Message:</strong>
              <p><%= message.message %></p>
            </td>
          </tr>

        <% }) %>
      </tbody>
    </table>

  <% } %>
</main>

<%- include("../partials/footer") %>