<%- include("../partials/head") %>

<%- include("../partials/header") %>

<h1>Contact Messages</h1>
<% if (messages.length === 0) { %>

<p>No messages found.</p>

<% } else { %>

<table border="1">

<tr>

<th>Name</th>

<th>Email</th>

<th>Subject</th>

<th>Date</th>

</tr>

<% messages.forEach(message => { %>

<tr>

<td><%= message.name %></td>

<td><%= message.email %></td>

<td><%= message.subject %></td>

<td><%= message.created_at %></td>

</tr>

<tr>

<td colspan="4">

<%= message.message %>

</td>

</tr>

<% }) %>

</table>

<% } %>

<%- include("../partials/footer") %>