<h1>Contact Us</h1>

<form
  action="/contact"
  method="POST"
>

<label>Name</label>

<input
  type="text"
  name="name"
  required
>

<br><br>

<label>Email</label>

<input
  type="email"
  name="email"
  required
>

<br><br>

<label>Subject</label>

<input
  type="text"
  name="subject"
  required
>

<br><br>

<label>Message</label>

<textarea
  name="message"
  required
></textarea>

<br><br>

<button>
  Send Message
</button>

</form>