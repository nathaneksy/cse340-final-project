<%- include("../partials/head") %>

<%- include("../partials/header") %>

<h1>Vehicle Details</h1>

<% if (errors && errors.length > 0) { %>

<div class="errors">
    <ul>

    <% errors.forEach(error => { %>

        <li><%= error.msg %></li>

    <% }) %>

    </ul>
</div>

<% } %>
<h1>
  <%= vehicle.year %>
  <%= vehicle.make %>
  <%= vehicle.model %>
</h1>
  <% if (images.length > 0) { %>

    <div class="vehicle-images">

      <% images.forEach(image => { %>

        <img
          src="<%= image.image_path %>"
          alt="<%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %>"
          width="500"
        >

      <% }) %>

    </div>

  <% } else { %>

    <p>No images available.</p>

  <% } %>
<p>
  Category:
  <%= vehicle.category_name %>
</p>

<p>
  Mileage:
  <%= vehicle.mileage %>
</p>

<p>
  Price:
  $<%= vehicle.price %>
</p>

<p>
  <%= vehicle.description %>
</p>

<hr>

<h2>Reviews</h2>

<% if (reviews.length === 0) { %>

  <p>No reviews yet.</p>

<% } %>

<% reviews.forEach(review => { %>

    
  <div>

    <strong>
      <%= review.first_name %>
      <%= review.last_name %>
    </strong>

    <p>
      Rating:
      <%= review.rating %>/5
    </p>

    <p>
      <%= review.review_text %>
    </p>

  </div>

  <% if (
  sessionUser &&
  sessionUser.user_id === review.user_id
) { %>

  <a
    href="/reviews/edit/<%= review.review_id %>"
  >
    Edit
  </a>

  <form
    action="/reviews/delete/<%= review.review_id %>"
    method="POST"
  >

    <button type="submit">
      Delete
    </button>

  </form>

<% } %>

  <hr>

  

<% }) %>

<% if (sessionUser) { %>

<h3>Leave a Review</h3>

<form
  action="/reviews/vehicle/<%= vehicle.vehicle_id %>"
  method="POST"
>

  <label>
    Rating
  </label>

  <select
    name="rating"
    required
  >
<option
    value="5"
    <%= Number(reviewForm?.rating) === 5 ? "selected" : "" %>
>
    5
</option>
    <option
      value="4"
      <%= Number(reviewForm?.rating) === 4 ? "selected" : "" %>
    >
      4
    </option>
    <option
      value="3"
      <%= Number(reviewForm?.rating) === 3 ? "selected" : "" %>
    >
      3
    </option>
    <option
      value="2"
      <%= Number(reviewForm?.rating) === 2 ? "selected" : "" %>
    >
      2
    </option>
    <option
      value="1"
      <%= Number(reviewForm?.rating) === 1 ? "selected" : "" %>
    >
      1
    </option>
  </select>

  <br><br>

<textarea
    name="review_text"
    required
><%= reviewForm?.review_text || "" %></textarea>

  <br><br>
  
  <button type="submit">
    Submit Review
  </button>

</form>

<% } else { %>

<p>
  Login to leave a review.
</p>




<% } %>

<% if (sessionUser) { %>

<hr>

<% if (errors && errors.length > 0) { %>

<div class="errors">
  <ul>

  <% errors.forEach(error => { %>

    <li><%= error.msg %></li>

  <% }) %>

  </ul>
</div>

<% } %>

<h2>Request Service</h2>

<form
  action="/service/vehicle/<%= vehicle.vehicle_id %>"
  method="POST"
>

  <label>
    Service Type
  </label>

  <select
    name="service_type"
  >
    <option
      value="Oil Change"
      <%= serviceForm?.service_type === "Oil Change"
          ? "selected"
          : "" %>>
      Oil Change
    </option>

    <option
      value="Inspection"
      <%= serviceForm?.service_type === "Inspection"
          ? "selected"
          : "" %>>
      Inspection
    </option>

    <option
      value="Tire Rotation"
      <%= serviceForm?.service_type === "Tire Rotation"
          ? "selected"
          : "" %>>
      Tire Rotation
    </option>

    <option
      value="General Repair"
      <%= serviceForm?.service_type === "General Repair"
          ? "selected"
          : "" %>>
      General Repair
    </option>
  </select>

  <br><br>

<textarea
  name="description"
  required
><%= serviceForm?.description || "" %></textarea>

  <br><br>

  <button type="submit">
    Submit Request
  </button>

</form>

<% } %>

<%- include("../partials/footer") %>