<%- include("../partials/head") %>

<%- include("../partials/header") %>

<h1>Register</h1>

<% if (errors && errors.length > 0) { %>

  <div class="errors">

    <ul>

      <% errors.forEach(error => { %>

        <li><%= error.msg %></li>

      <% }) %>

    </ul>

  </div>

<% } %>

<form method="POST" action="/account/register">

  <label>
    First Name
    <input
      type="text"
      name="first_name"
      value="<%= formData?.first_name || '' %>"
    >
  </label>

  <br><br>

  <label>
    Last Name
    <input
      type="text"
      name="last_name"
      value="<%= formData?.last_name || '' %>"
    >
  </label>

  <br><br>

  <label>
    Email
    <input
      type="email"
      name="email"
      value="<%= formData?.email || '' %>"
    >
  </label>

  <br><br>

  <label>
    Password
    <input
      type="password"
      name="password"
    >
  </label>

  <br><br>

  <button type="submit">
    Register
  </button>

</form>

<%- include("../partials/footer") %>