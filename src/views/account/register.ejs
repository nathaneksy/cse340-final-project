<h1>Register</h1>

<form method="POST" action="/account/register">

  <label>
    First Name
    <input type="text" name="first_name">
  </label>

  <br><br>

  <label>
    Last Name
    <input type="text" name="last_name">
  </label>

  <br><br>

  <label>
    Email
    <input type="email" name="email">
  </label>

  <br><br>

  <label>
    Password
    <input type="password" name="password">
  </label>

  <br><br>

  <button type="submit">
    Register
  </button>

</form>