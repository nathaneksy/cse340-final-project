<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>

<h1>Login</h1>

  <% if (errors.length > 0) { %>
    <div class="errors">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

<form action="/account/login" method="POST">

  <label>
    Email
    <input
        type="email"
        name="email"
        value="<%= formData?.email || '' %>"
    >
  </label>

  <br><br>

  <label>
    Password
    <input
      type="password"
      name="password"
      required
    >
  </label>

  <br><br>

  <button type="submit">
    Login
  </button>

</form>

</body>
</html>