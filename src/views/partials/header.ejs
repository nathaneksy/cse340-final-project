    <a href="/contact">Contact</a>

    <% if (typeof sessionUser !== "undefined" && sessionUser) { %>
      <a href="/dashboard">Dashboard</a>

      <% if (sessionUser.role === "customer") { %>

    <a href="/service/my-requests">My Service Requests</a>

      <% } %>

